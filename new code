# 6. ADD sports1 COLUMN
# ADD adds a new column.
# FIRST places the column at the beginning.
# ============================================================

Alter table snday add sports1 varchar(25) First;

# OUTPUT
# Query OK, 0 rows affected


# ============================================================
# 7. DISPLAY DATA
# ============================================================

select * from snday;

# OUTPUT
# sports1 appears as the first column.


# ============================================================
# 8. ADD car COLUMN
#
# The original screenshot code was:
# Alter table snday add car after sports1 varchar(25);
#
# This syntax is incorrect.
# VARCHAR(25) must come immediately after car.
# AFTER sports1 places car after sports1.
# ============================================================

Alter table snday add car varchar(25) after sports1;

# OUTPUT
# Query OK, 0 rows affected


# ============================================================
# 9. DISPLAY DATA
# ============================================================

select * from snday;

# OUTPUT
# car appears after sports1.


# ============================================================
# 10. ADD bike COLUMN
# AFTER businesscost places bike after businesscost.
# ============================================================

alter table snday add bike varchar(20) after businesscost;

# OUTPUT
# Query OK, 0 rows affected


# ============================================================
# 11. DISPLAY DATA
# ============================================================

select * from snday;

# OUTPUT
# bike appears after businesscost.


# ============================================================
# 12. DROP sports1 AND bike
# DROP removes the complete column from the table.
# ============================================================

ALTER TABLE snday DROP sports1, DROP bike;

# OUTPUT
# Query OK, 0 rows affected


# ============================================================
# 13. ADD remarks COLUMN
# Adds a new column named remarks.
# ============================================================

ALTER TABLE snday ADD remarks VARCHAR(25);

# OUTPUT
# Query OK, 0 rows affected


# ============================================================
# 14. DISPLAY DATA
# ============================================================

select * from snday;

# OUTPUT
# remarks column appears in the table.


# ============================================================
# 15. UPDATE ONE RECORD
# WHERE movieid=1 selects only movieid 1.
# ============================================================

update snday set remarks="good" where movieid=1;

# OUTPUT
# Query OK, 1 row affected


# ============================================================
# 16. DISPLAY DATA
# ============================================================

select * from snday;

# OUTPUT
# movieid 1 has remarks = good.



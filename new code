# ============================================================
# 24. UPDATE RELEASE DATE OF MOVIE 2
# CURDATE() returns the current date.
# ============================================================

update snday set releasedate=curdate() where movieid=2;

# OUTPUT
# Query OK, 1 row affected


# ============================================================
# 25. DISPLAY DATA
# ============================================================

select * from snday;

# OUTPUT
# movieid 2 now has the current date.


# ============================================================
# 26. UPDATE USING OR
# If either condition is true, the record is updated.
# ============================================================

UPDATE snday SET releasedate=CURDATE()
WHERE category='action' OR productioncost=55000000;

# OUTPUT
# Query OK, 4 rows affected


# ============================================================
# 27. UPDATE ALL ACTION MOVIES
# Only records with category = action are selected.
# ============================================================

UPDATE snday SET releasedate=CURDATE()
WHERE category='action';

# OUTPUT
# Query OK, 2 rows affected


